# Application
IPMS_APP_NAME="Investment Portfolio Management System"
IPMS_VERSION=0.1.0
# local | test | staging | production
IPMS_ENVIRONMENT=local
# DEBUG | INFO | WARNING | ERROR | CRITICAL
IPMS_LOG_LEVEL=INFO

# Database
IPMS_DATABASE_URL=postgresql+psycopg://ipms:ipms@localhost:5432/ipms
IPMS_DATABASE_POOL_SIZE=5
IPMS_DATABASE_MAX_OVERFLOW=10
IPMS_DATABASE_POOL_TIMEOUT_SECONDS=30

# Auth
IPMS_AUTH_SECRET_KEY=change-me
IPMS_AUTH_TOKEN_TTL_MINUTES=60

# Batch processing
IPMS_BATCH_COMMIT_INTERVAL=1000
